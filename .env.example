# ── agent 入口（只在服务器端读取，不会进入前端产物）──────────────────────
# 全局口令：弹窗里输入的那串字符。条目里没单独写 password 时用它。
HOSHINO_AGENT_PASSWORD=change-me-please

# 入口列表：JSON 数组，一个对象一个按钮。
#   label     按钮上的字样（可配置）
#   href      校验通过后跳转的地址：同站路径 /agent，或完整 https://…
#   password  可选，这条入口自己的口令；省略则用上面的全局口令
# 配几条就渲染几个按钮，按钮多了会自动换行，不会撑坏布局。
HOSHINO_AGENT_TARGETS=[{"label":"agent 助手","href":"/agent"},{"label":"数据看板","href":"https://dash.hoshino.cloud"}]

# 只配一个入口时也可以沿用旧写法（配了 HOSHINO_AGENT_TARGETS 就以它为准）：
# HOSHINO_AGENT_TARGET=/agent
# HOSHINO_AGENT_LABEL=agent 助手

# 其它服务凭据请写进 .env.local（已被 git 忽略），不要放在这个示例文件里。
# 例如：HOSHINO_DNSPOD_TOKEN=…  HOSHINO_DNSPOD_ID=…
